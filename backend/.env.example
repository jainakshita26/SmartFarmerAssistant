# Copy this file to backend/.env and fill in your values.
# The backend loads backend/.env automatically via python-dotenv.

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/

# Secret used to sign JWT access tokens
JWT_SECRET=change_this_to_a_long_random_string

# Google OAuth client ID (frontend uses VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your_actual_google_client_id_here

# Razorpay payments for the marketplace
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email OTP delivery via Gmail SMTP (use an App Password, not your Gmail password)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Optional: Brevo HTTP email API instead of SMTP
BREVO_API_KEY=

# Protects GET /auth/admin/users?secret=...
ADMIN_SECRET=change_this_admin_secret
